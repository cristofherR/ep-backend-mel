# Plantilla de variables de entorno — copia a .env y completa tus valores.
# NUNCA subas el archivo .env al repositorio (ya está en .gitignore).

# Base de datos PostgreSQL (el schema del builder se aplica aquí)
DB_HOST=tu-servidor.ejemplo.com
DB_PORT=5432
DB_NAME=tu_base_de_datos
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_SSLMODE=require

# Cadena completa alternativa (si tu cliente la prefiere)
DATABASE_URL=postgresql://usuario:clave@host:5432/base

# Schema (namespace) que genera build.py; ver arquitectura/builder/spec/_config.yaml
DB_SCHEMA=efectoancash

# Fuentes de ejemplo (rutas a TUS archivos; no se versionan)
PADRON_XLSX=/ruta/a/tu_padron.xlsx
POA_XLSX=/ruta/a/tu_poa.xlsx
